# ── Supabase (optional — app runs in local demo mode without these) ──────────
# Create a project at https://supabase.com, then copy the values from
# Project Settings → API. Run the SQL files in /supabase/migrations in order.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by the schedule import script (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only live score provider settings. Keep API keys out of NEXT_PUBLIC_*.
LIVE_SCORE_PROVIDER=manual
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
SPORTMONKS_API_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
# Used for absolute URLs in metadata, ICS files and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
