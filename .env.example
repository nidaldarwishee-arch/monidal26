# ── Supabase (optional — app runs in local demo mode without these) ──────────
# Create a project at https://supabase.com, then copy the values from
# Project Settings → API keys. Provision the database with `npm run db:setup-sql`
# (see supabase/README.md) or run the SQL files in /supabase/migrations in order.
NEXT_PUBLIC_SUPABASE_URL=
# Either the modern publishable key (sb_publishable_...) or the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias read before NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for admin/import/analytics backend work (never expose to the
# client). Use the secret key (sb_secret_...) or the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only live score provider settings. Keep API keys out of NEXT_PUBLIC_*.
LIVE_SCORE_PROVIDER=manual
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
SPORTMONKS_API_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
# Used for absolute URLs in metadata, ICS files and share links
# Optional public analytics IDs. Supabase analytics capture works without these.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
